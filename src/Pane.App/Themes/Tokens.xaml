<?xml version="1.0" encoding="utf-8"?>
<!--
  Pane 设计令牌（WinUI 版）。归设计负责人。
  和网页原型 prototype/tokens.css 一一对应：资源名 = "Pane" + CSS 变量名去掉开头的两个短横线后转驼峰，
  例如 text-1 → PaneText1Color / PaneText1Brush，radius-panel → PaneRadiusPanel。
  半透明颜色按原型的 rgb(r g b / a) 换算成 #AARRGGBB（a × 255 四舍五入）。
  改这里的取值时，原型里同名变量一起改。
  主题字典（Light / Dark）里互相引用必须用 ThemeResource；用 StaticResource 会在加载时按程序当时的主题解析，
  两套画刷都拿到同一个颜色（曾导致浅色主题文字变白）。

  用户在设置里能改的值（主题色、窗口圆角、玻璃参数、动效速度）这里只放默认值，
  运行时由程序覆盖；派生值（如列表项圆角 = 面板圆角 - 8）由代码按注释里的公式算。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ================= 浅色 ================= -->
        <ResourceDictionary x:Key="Light">
            <!-- 玻璃着色（tint / luminosity），透明度见下方 PaneGlass* -->
            <Color x:Key="PaneTintColor">#FFF6F6F8</Color>
            <Color x:Key="PaneLuminosityColor">#FFFFFFFF</Color>

            <!-- 文字：rgb(20 20 24 / .92 .62 .42) -->
            <Color x:Key="PaneText1Color">#EB141418</Color>
            <Color x:Key="PaneText2Color">#9E141418</Color>
            <Color x:Key="PaneText3Color">#6B141418</Color>

            <!-- 线与填充 -->
            <Color x:Key="PaneStrokeColor">#14000000</Color>        <!-- black / .08 -->
            <Color x:Key="PaneFillHoverColor">#0B000000</Color>     <!-- black / .045 -->
            <Color x:Key="PaneFillSelectedColor">#9EFFFFFF</Color>  <!-- white / .62 -->
            <Color x:Key="PaneFillControlColor">#80FFFFFF</Color>   <!-- white / .5 -->

            <!-- 玻璃边：高光强度 0.7 时的值。公式 内高光 = white / (.75 × 高光)，外描边 = black / (.10 × 高光) -->
            <Color x:Key="PaneEdgeLightColor">#86FFFFFF</Color>     <!-- white / .525 -->
            <Color x:Key="PaneEdgeOuterColor">#12000000</Color>     <!-- black / .07 -->
            <x:Double x:Key="PaneEdgeLightFactor">0.75</x:Double>
            <x:Double x:Key="PaneEdgeOuterFactor">0.10</x:Double>

            <SolidColorBrush x:Key="PaneText1Brush" Color="{ThemeResource PaneText1Color}"/>
            <SolidColorBrush x:Key="PaneText2Brush" Color="{ThemeResource PaneText2Color}"/>
            <SolidColorBrush x:Key="PaneText3Brush" Color="{ThemeResource PaneText3Color}"/>
            <SolidColorBrush x:Key="PaneStrokeBrush" Color="{ThemeResource PaneStrokeColor}"/>
            <SolidColorBrush x:Key="PaneFillHoverBrush" Color="{ThemeResource PaneFillHoverColor}"/>
            <SolidColorBrush x:Key="PaneFillSelectedBrush" Color="{ThemeResource PaneFillSelectedColor}"/>
            <SolidColorBrush x:Key="PaneFillControlBrush" Color="{ThemeResource PaneFillControlColor}"/>
        </ResourceDictionary>

        <!-- ================= 深色 ================= -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="PaneTintColor">#FF1C1C20</Color>
            <Color x:Key="PaneLuminosityColor">#FF0A0A0C</Color>

            <!-- 文字：white / .94 .64 .40 -->
            <Color x:Key="PaneText1Color">#F0FFFFFF</Color>
            <Color x:Key="PaneText2Color">#A3FFFFFF</Color>
            <Color x:Key="PaneText3Color">#66FFFFFF</Color>

            <Color x:Key="PaneStrokeColor">#14FFFFFF</Color>        <!-- white / .08 -->
            <Color x:Key="PaneFillHoverColor">#0FFFFFFF</Color>     <!-- white / .06 -->
            <Color x:Key="PaneFillSelectedColor">#1FFFFFFF</Color>  <!-- white / .12 -->
            <Color x:Key="PaneFillControlColor">#12FFFFFF</Color>   <!-- white / .07 -->

            <!-- 公式 内高光 = white / (.22 × 高光)，外描边：无（见下） -->
            <Color x:Key="PaneEdgeLightColor">#27FFFFFF</Color>     <!-- white / .154 -->
            <!-- 2026-10-28：深色不画外圈黑线（亮色、花哨背景上像一圈黑框），内高光改成整圈：
                 从上到下强度 100% / 60% / 45% / 65%（浅色仍是 100% / 30% / 10% / 45%）。原型 tokens.css 的 edge-mid 等同步 -->
            <Color x:Key="PaneEdgeOuterColor">#00000000</Color>
            <x:Double x:Key="PaneEdgeLightFactor">0.22</x:Double>
            <x:Double x:Key="PaneEdgeOuterFactor">0</x:Double>

            <SolidColorBrush x:Key="PaneText1Brush" Color="{ThemeResource PaneText1Color}"/>
            <SolidColorBrush x:Key="PaneText2Brush" Color="{ThemeResource PaneText2Color}"/>
            <SolidColorBrush x:Key="PaneText3Brush" Color="{ThemeResource PaneText3Color}"/>
            <SolidColorBrush x:Key="PaneStrokeBrush" Color="{ThemeResource PaneStrokeColor}"/>
            <SolidColorBrush x:Key="PaneFillHoverBrush" Color="{ThemeResource PaneFillHoverColor}"/>
            <SolidColorBrush x:Key="PaneFillSelectedBrush" Color="{ThemeResource PaneFillSelectedColor}"/>
            <SolidColorBrush x:Key="PaneFillControlBrush" Color="{ThemeResource PaneFillControlColor}"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ================= 主题色（accent，用户可选，运行时覆盖） ================= -->
    <!-- 只用于控件状态和焦点，不用于文字、图标着色和大面积底色（docs/design.md「主题色」） -->
    <Color x:Key="PaneAccentColor">#FF5874C9</Color>            <!-- 雾蓝（默认） -->
    <Color x:Key="PaneAccentTealColor">#FF17958B</Color>        <!-- 青碧 -->
    <Color x:Key="PaneAccentMossColor">#FF5F8F4E</Color>        <!-- 苔绿 -->
    <Color x:Key="PaneAccentGraphiteColor">#FF4A505C</Color>    <!-- 石墨 -->
    <SolidColorBrush x:Key="PaneAccentBrush" Color="{ThemeResource PaneAccentColor}"/>

    <!-- ================= 玻璃（默认值；设置「玻璃参数（高级）」可改，深浅色各一套） ================= -->
    <!-- 由玻璃宿主读取，作用在 Composition 层上，不是 XAML 画刷 -->
    <x:Double x:Key="PaneGlassTintOpacity">0.42</x:Double>      <!-- glass-tint-opacity：着色层透明度 -->
    <x:Double x:Key="PaneGlassLumOpacity">0.38</x:Double>       <!-- glass-lum-opacity：亮度层透明度 -->
    <x:Double x:Key="PaneGlassSaturation">1.6</x:Double>        <!-- glass-saturation -->
    <x:Double x:Key="PaneGlassNoise">0.035</x:Double>           <!-- glass-noise：原生暂未实现 -->
    <x:Double x:Key="PaneGlassHighlight">0.7</x:Double>         <!-- glass-highlight：高光边强度 0~1 -->
    <x:Double x:Key="PaneGlassShadow">0.7</x:Double>            <!-- glass-shadow：阴影强度 0~1 -->
    <x:Double x:Key="PaneGlassExtraBlur">0</x:Double>           <!-- 加强模糊，0 = 只用系统模糊（原型 glass-blur 不对应） -->
    <!--
      阴影两层（DIP），s = 阴影强度：
        远：偏移 y = 24s，模糊 = 64s，黑色透明度 = .32s   （s = .7 时 ≈ 17 / 45 / .224，和 007/008 一致）
        近：偏移 y = 2，  模糊 = 8，  黑色透明度 = .12s
    -->

    <!-- ================= 圆角（radius-*；面板圆角用户可调，其余按公式派生） ================= -->
    <x:Double x:Key="PaneRadiusPanelValue">20</x:Double>
    <CornerRadius x:Key="PaneRadiusPanel">20</CornerRadius>
    <CornerRadius x:Key="PaneRadiusItem">12</CornerRadius>      <!-- max(4, 面板 - 8) -->
    <CornerRadius x:Key="PaneRadiusControl">10</CornerRadius>   <!-- max(4, 面板 - 10) -->
    <!-- 胶囊：CSS 的 999 会自动收成半高；WinUI 不会（会变成椭圆），胶囊形状请写死高度并用「高度 / 2」做圆角，不要用这个值 -->
    <CornerRadius x:Key="PaneRadiusChip">999</CornerRadius>

    <!-- ================= 动效（毫秒；乘以设置里的速度倍率） ================= -->
    <x:Double x:Key="PaneDurFast">120</x:Double>
    <x:Double x:Key="PaneDurNormal">220</x:Double>
    <x:Double x:Key="PaneDurSlow">360</x:Double>
    <!-- 三次贝塞尔控制点 x1,y1,x2,y2；Composition 用 CreateCubicBezierEasingFunction，XAML 动画用 KeySpline -->
    <x:String x:Key="PaneEaseSmooth">0.2,0,0,1</x:String>       <!-- 消失、普通过渡 -->
    <x:String x:Key="PaneEaseSpring">0.34,1.36,0.64,1</x:String> <!-- 出现：轻微回弹 -->
    <x:String x:Key="PaneEaseGlide">0.25,1.05,0.35,1</x:String> <!-- 选中高亮滑动 -->
    <x:Double x:Key="PaneEnterScale">0.94</x:Double>
    <!-- 按下缩放（docs/design.md 通用控件表） -->
    <x:Double x:Key="PanePressScaleButton">0.97</x:Double>
    <x:Double x:Key="PanePressScaleIconButton">0.9</x:Double>
    <x:Double x:Key="PanePressScaleSwatch">0.92</x:Double>

    <!-- ================= 字体（font-*，逗号后为回落） ================= -->
    <FontFamily x:Key="PaneFontUi">MiSans VF, Microsoft YaHei UI, Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="PaneFontDisplay">MiSans VF, Microsoft YaHei UI, Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="PaneFontMono">Cascadia Mono, Consolas, MiSans VF</FontFamily>
    <x:Double x:Key="PaneTextXs">11</x:Double>
    <x:Double x:Key="PaneTextSm">12</x:Double>
    <x:Double x:Key="PaneTextMd">14</x:Double>
    <x:Double x:Key="PaneTextLg">16</x:Double>
    <x:Double x:Key="PaneTextSearch">20</x:Double>

    <!-- ================= 图标 ================= -->
    <x:Double x:Key="PaneIconStroke">1.75</x:Double>            <!-- Lucide 线宽（默认 2） -->

    <!-- ================= 间距（space-1 ~ 6） ================= -->
    <x:Double x:Key="PaneSpace1">4</x:Double>
    <x:Double x:Key="PaneSpace2">8</x:Double>
    <x:Double x:Key="PaneSpace3">12</x:Double>
    <x:Double x:Key="PaneSpace4">16</x:Double>
    <x:Double x:Key="PaneSpace5">20</x:Double>
    <x:Double x:Key="PaneSpace6">24</x:Double>

</ResourceDictionary>
