<?xml version="1.0" encoding="utf-8"?>
<!--
  Pane 的通用控件样式（设计负责人）。对应原型 prototype/style.css 的通用部分。
  原则（docs/design.md「设置页」）：不用系统默认外观，照原型自绘。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      输入框：Pane 里所有输入框都由外面的 Border 画框（搜索行、剪贴板搜索框、设置页输入框），
      TextBox 本身去掉底色、边框和焦点下划线；文字和占位符用令牌颜色。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource PaneText1Color}"/>
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{ThemeResource PaneText1Color}"/>
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{ThemeResource PaneText1Color}"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource PaneText3Color}"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource PaneText3Color}"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource PaneText3Color}"/>
            <!-- 剪贴板搜索命中：中性浅底（text-1 / .14） -->
            <SolidColorBrush x:Key="PaneMatchBackgroundBrush" Color="#24141418"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource PaneText1Color}"/>
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{ThemeResource PaneText1Color}"/>
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{ThemeResource PaneText1Color}"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource PaneText3Color}"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource PaneText3Color}"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource PaneText3Color}"/>
            <SolidColorBrush x:Key="PaneMatchBackgroundBrush" Color="#24FFFFFF"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
    <Thickness x:Key="TextControlThemePadding">0</Thickness>

    <!-- 键帽（原型 kbd） -->
    <Style x:Key="PaneKbdBorder" TargetType="Border">
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="Padding" Value="5,1,5,1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Background" Value="{ThemeResource PaneFillControlBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource PaneStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="PaneKbdText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PaneFontUi}"/>
        <Setter Property="FontSize" Value="{StaticResource PaneTextXs}"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ThemeResource PaneText2Brush}"/>
    </Style>

    <!-- 分组标题（原型 .group-label） -->
    <Style x:Key="PaneGroupLabel" TargetType="TextBlock">
        <Setter Property="Padding" Value="12,8,12,4"/>
        <Setter Property="FontFamily" Value="{StaticResource PaneFontUi}"/>
        <Setter Property="FontSize" Value="{StaticResource PaneTextXs}"/>
        <Setter Property="CharacterSpacing" Value="20"/>
        <Setter Property="Foreground" Value="{ThemeResource PaneText3Brush}"/>
    </Style>

    <!-- 图标按钮（原型 .icon-btn）：透明底，悬停中性填充；按下缩小 0.9 由代码做 -->
    <Style x:Key="PaneIconButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground" Value="{ThemeResource PaneText2Brush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Background" Value="{ThemeResource PaneFillHoverBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource PaneText1Brush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Background" Value="{ThemeResource PaneFillHoverBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource PaneText1Brush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文字按钮（原型 .btn 的次要样式）：中性填充 + 细描边，悬停加深；按下缩小 0.97 以后由代码做 -->
    <Style x:Key="PaneTextButton" TargetType="Button">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="CornerRadius" Value="{StaticResource PaneRadiusControl}"/>
        <Setter Property="FontFamily" Value="{StaticResource PaneFontUi}"/>
        <Setter Property="FontSize" Value="{StaticResource PaneTextSm}"/>
        <Setter Property="Foreground" Value="{ThemeResource PaneText1Brush}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}"
                                BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border x:Name="Hover" Background="{ThemeResource PaneFillHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                        <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 主按钮（安装程序这类一页只有一个主要动作的地方）：主题色实心胶囊，高 40、圆角为高的一半，白字；悬停叠一层白、按下叠一层黑。
         Background 可以在用的地方覆盖（卸载用警示红）。 -->
    <Style x:Key="PanePrimaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="24,0,24,0"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="{StaticResource PaneAccentBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PaneFontUi}"/>
        <Setter Property="FontSize" Value="{StaticResource PaneTextMd}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border x:Name="Hover" Background="#1FFFFFFF" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                        <Border x:Name="Press" Background="#1A000000" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                        <Border x:Name="Ring" Margin="-3" BorderBrush="{TemplateBinding Background}" BorderThickness="2" CornerRadius="23" Opacity="0"/>
                        <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Press.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Bg.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <!-- 键盘焦点：外面一圈同色细环（主题色只用在焦点上，和 FocusRing 一致：只在键盘焦点时显示） -->
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="PointerFocused"/>
                                <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="Ring.Opacity" Value="0.55"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
