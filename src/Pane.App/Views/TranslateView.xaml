<?xml version="1.0" encoding="utf-8"?>
<!--
  翻译窗口（二级窗口，设计负责人）。照原型 prototype/launcher.html #tw（docs/design.md「翻译窗口」）。
  默认 760 × 460，可改大小（最小 560 × 340）。顶栏 56；左原文右译文；底栏 38 写明翻译用的模型。
  边打边翻（停手 0.6 秒），Ctrl+Enter 立即翻；Esc 清空原文（不关窗口）；Ctrl+W 关。
-->
<UserControl
    x:Class="Pane.Views.TranslateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Pane.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Head" Padding="18,0,10,0" ColumnSpacing="10" Background="Transparent" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Height="28" Padding="8,0,10,0" CornerRadius="14" VerticalAlignment="Center"
                    Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:PaneIcon Glyph="translate" Width="15" Height="15" VerticalAlignment="Center" Foreground="{ThemeResource PaneText2Brush}"/>
                    <TextBlock Text="{x:Bind loc:Strings.Common_Translate}" VerticalAlignment="Center" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText2Brush}"/>
                </StackPanel>
            </Border>
            <!-- 语言：原文（自动识别）⇄ 翻译成。点「翻译成」换目标语言，⇄ 把译文换到左边接着翻 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="FromText" Text="{x:Bind loc:Strings.Translate_AutoDetect}" VerticalAlignment="Center" Margin="10,0,6,0"
                           FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText2Brush}"/>
                <Button Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlSm}" Height="{StaticResource PaneControlSm}" CornerRadius="14" Click="OnSwap" ToolTipService.ToolTip="{x:Bind loc:Strings.Translate_SwapHint}">
                    <Viewbox Width="14" Height="14">
                        <Path Data="M8,3 L4,7 L8,11 M4,7 H20 M16,21 L20,17 L16,13 M20,17 H4" Stroke="{ThemeResource PaneText2Brush}" StrokeThickness="1.75"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/>
                    </Viewbox>
                </Button>
                <Button x:Name="ToButton" Style="{StaticResource PaneIconButton}" Width="NaN" Height="{StaticResource PaneControlSm}" Padding="10,0,10,0" CornerRadius="14" Click="OnTarget"
                        ToolTipService.ToolTip="{x:Bind loc:Strings.Translate_TargetHint}">
                    <TextBlock x:Name="ToText" Text="{x:Bind loc:Strings.Translate_LanguageChinese}" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}"/>
                </Button>
            </StackPanel>
            <Button x:Name="PinButton" Grid.Column="3" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}" Click="OnPin" ToolTipService.ToolTip="{x:Bind loc:Strings.Common_AlwaysOnTop}">
                <c:PaneIcon x:Name="PinIcon" Glyph="pin" Width="16" Height="16"/>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}" Click="OnClose" ToolTipService.ToolTip="{x:Bind loc:Strings.Common_CloseWindowHint}">
                <c:PaneIcon Glyph="close" Width="16" Height="16"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Padding="18,14,18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="Source" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="{x:Bind loc:Strings.Translate_InputPlaceholder}" Padding="0" MinHeight="0"
                         FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextLg}" SelectionHighlightColor="{StaticResource PaneAccentBrush}"
                         IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="OnSourceChanged"/>
                <Grid Grid.Row="1">
                    <TextBlock x:Name="CountText" Text="{x:Bind loc:Strings.Translate_EmptyCount}" VerticalAlignment="Center" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
                    <Button Style="{StaticResource PaneTextButton}" HorizontalAlignment="Right" MinHeight="{StaticResource PaneControlSm}" Height="{StaticResource PaneControlSm}" CornerRadius="14" Content="{x:Bind loc:Strings.Common_Clear}" Click="OnClear"/>
                </Grid>
            </Grid>
            <Grid Grid.Column="1" Padding="18,14,18,10" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="OutScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="Out" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="26.4"
                               FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextLg}" Foreground="{ThemeResource PaneText1Brush}"/>
                </ScrollViewer>
                <Grid Grid.Row="1" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StateText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
                    <Button x:Name="ActionButton" Grid.Column="1" Style="{StaticResource PaneTextButton}" MinHeight="{StaticResource PaneControlSm}" Height="{StaticResource PaneControlSm}" CornerRadius="14" Visibility="Collapsed" Click="OnAction"/>
                    <Button Grid.Column="2" Style="{StaticResource PaneTextButton}" MinHeight="{StaticResource PaneControlSm}" Height="{StaticResource PaneControlSm}" CornerRadius="14" Content="{x:Bind loc:Strings.SuperPanel_CopyTranslation}" Click="OnCopy"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Padding="16,0,16,0" ColumnSpacing="16" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ModelText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            <c:WrapPanel x:Name="Hints" Grid.Column="1" VerticalAlignment="Center" HorizontalSpacing="12" VerticalSpacing="0"/>
        </Grid>

        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="HintLabelProto" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            <TextBlock x:Name="IdleProto" Foreground="{ThemeResource PaneText3Brush}"/>
            <TextBlock x:Name="TextProto" Foreground="{ThemeResource PaneText1Brush}"/>
            <Border x:Name="KbdProto" Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}"/></Border>
        </StackPanel>
    </Grid>
</UserControl>
