<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 对话窗口（二级窗口，设计负责人）。照原型 prototype/launcher.html #cw（docs/design.md「AI 对话窗口」）。
  默认 780 × 620，可改大小（最小 520 × 420）。顶栏 56：模型切换、新对话（Ctrl+N）；中间对话；底部输入框（自动长高，最高 140）。
  Enter 发送、Shift+Enter 换行；生成中发送键变停止键；Esc 先停止生成、再清空输入（不关窗口）；Ctrl+W 关。只保留这一次对话。
-->
<UserControl
    x:Class="Pane.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Head" Padding="18,0,10,0" ColumnSpacing="10" Background="Transparent" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Height="28" Padding="8,0,10,0" CornerRadius="14" VerticalAlignment="Center"
                    Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:PaneIcon Glyph="ai" Width="15" Height="15" VerticalAlignment="Center" Foreground="{ThemeResource PaneText2Brush}"/>
                    <TextBlock Text="AI 对话" VerticalAlignment="Center" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText2Brush}"/>
                </StackPanel>
            </Border>
            <Button x:Name="ModelButton" Grid.Column="1" Style="{StaticResource PaneIconButton}" Width="NaN" Height="{StaticResource PaneControlSm}" Padding="10,0,8,0" CornerRadius="14" Click="OnModel"
                    ToolTipService.ToolTip="换模型（只对这次对话）">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock x:Name="ModelText" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}"/>
                    <c:PaneIcon x:Name="ModelChevron" Glyph="chev-d" Width="13" Height="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource PaneTextButton}" Height="{StaticResource PaneControlSm}" CornerRadius="14" Click="OnNew" ToolTipService.ToolTip="新对话（Ctrl+N）" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <c:PaneIcon Glyph="plus" Width="13" Height="13" VerticalAlignment="Center" Foreground="{ThemeResource PaneText1Brush}"/>
                    <TextBlock Text="新对话" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="PinButton" Grid.Column="4" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}" Click="OnPin" ToolTipService.ToolTip="总在最前">
                <c:PaneIcon x:Name="PinIcon" Glyph="pin" Width="16" Height="16"/>
            </Button>
            <Button Grid.Column="5" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}" Click="OnClose" ToolTipService.ToolTip="关闭（Ctrl+W）">
                <c:PaneIcon Glyph="close" Width="16" Height="16"/>
            </Button>
        </Grid>

        <!-- 对话 -->
        <ScrollViewer x:Name="ChatScroller" Grid.Row="1" Padding="22,18,22,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
            <StackPanel x:Name="Messages" Spacing="16"/>
        </ScrollViewer>
        <!-- 空状态：两个示例问题 -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <TextBlock TextAlignment="Center" LineHeight="24" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText3Brush}"
                       Text="新的对话&#x0a;只保留到关掉窗口为止"/>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Button Style="{StaticResource PaneTextButton}" CornerRadius="14" Content="玻璃上的文字怎么保持清晰" Click="OnSuggestion"/>
                <Button Style="{StaticResource PaneTextButton}" CornerRadius="14" Content="写一个防抖函数" Click="OnSuggestion"/>
            </StackPanel>
        </StackPanel>

        <!-- 模型菜单（原型 controls.js 下拉框的简化版：玻璃上的中性浮层，选中项加粗带勾） -->
        <Border x:Name="ModelMenu" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="96,-6,0,0" MinWidth="200" Padding="4" Visibility="Collapsed"
                CornerRadius="{StaticResource PaneRadiusItem}" Background="{ThemeResource PaneFillSelectedBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
            <StackPanel x:Name="ModelList" Spacing="2"/>
        </Border>

        <!-- 输入 -->
        <StackPanel Grid.Row="2">
            <Grid Margin="14,6,14,6" Padding="14,8,8,8" ColumnSpacing="8" CornerRadius="18"
                  Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="0" MaxHeight="140" Padding="0,2,0,2" VerticalAlignment="Center"
                         PlaceholderText="问点什么…" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}"
                         SelectionHighlightColor="{StaticResource PaneAccentBrush}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="OnInputChanged"/>
                <Button x:Name="SendButton" Grid.Column="1" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}" CornerRadius="16" Padding="0" VerticalAlignment="Bottom" Click="OnSend"
                        Background="{StaticResource PaneAccentBrush}" Style="{StaticResource PanePrimaryButton}" MinHeight="{StaticResource PaneControlMd}" ToolTipService.ToolTip="发送（Enter）">
                    <Grid Width="16" Height="16">
                        <Viewbox x:Name="SendIcon">
                            <Path Data="M5,12 L12,5 L19,12 M12,19 V5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/>
                        </Viewbox>
                        <Border x:Name="StopIcon" Width="10" Height="10" CornerRadius="2" Visibility="Collapsed"/>
                    </Grid>
                </Button>
            </Grid>
            <c:WrapPanel x:Name="Hints" Margin="22,-2,22,10" HorizontalSpacing="12" VerticalSpacing="0"/>
        </StackPanel>

        <!-- 样板（NativeAOT 下不按名字查资源） -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="HintLabelProto" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            <TextBlock x:Name="BodyProto" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText1Brush}"/>
            <TextBlock x:Name="MonoProto" FontFamily="{StaticResource PaneFontMono}" FontSize="12" Foreground="{ThemeResource PaneText2Brush}"/>
            <TextBlock x:Name="ErrorProto" Foreground="{StaticResource PaneDangerBrush}"/>
            <TextBlock x:Name="Text3Proto" Foreground="{ThemeResource PaneText3Brush}"/>
            <Border x:Name="BubbleProto" Background="{ThemeResource PaneFillSelectedBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}"/>
            <Border x:Name="CodeProto" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}"/>
            <Border x:Name="HoverProto" Background="{ThemeResource PaneFillHoverBrush}"/>
            <Border x:Name="StopProto" Background="{ThemeResource PaneText1Brush}"/>
            <Border x:Name="KbdProto" Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}"/></Border>
            <Button x:Name="IconButtonProto" Style="{StaticResource PaneIconButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
