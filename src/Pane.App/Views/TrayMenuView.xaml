<?xml version="1.0" encoding="utf-8"?>
<!--
  托盘菜单（设计负责人，2026-10-30）。照原型 prototype/tray.html：宽 264、内边距 6、每项高 34。
  内容固定，按状态显隐：有更新已下载时最上面「新版本 x 已下载好 / 重启并更新」，然后打开启动器、打开剪贴板（右边显示热键）、设置，
  分隔，暂停手势（开关：打开时图标换成勾），分隔，退出 Pane。
  位置由宿主按右键那一刻的鼠标位置算（PanelPlacement.Tray）；失去焦点 / 点外面 / Esc 收起；↑↓ 选、Enter 执行。
-->
<UserControl
    x:Class="Pane.Views.TrayMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="True" UseSystemFocusVisuals="False">

    <UserControl.Resources>
        <Style x:Key="ItemRow" TargetType="Grid">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="ColumnSpacing" Value="10"/>
            <Setter Property="CornerRadius" Value="{StaticResource PaneRadiusControl}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="ItemText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PaneFontUi}"/>
            <Setter Property="FontSize" Value="{StaticResource PaneTextMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{ThemeResource PaneText1Brush}"/>
        </Style>
        <Style x:Key="ItemIcon" TargetType="c:PaneIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource PaneText2Brush}"/>
        </Style>
        <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="10,5,10,5"/>
            <Setter Property="Background" Value="{ThemeResource PaneStrokeBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel x:Name="Root" Width="264" Padding="6" VerticalAlignment="Top">
            <TextBlock x:Name="UpdateHead" Margin="10,6,10,4" Visibility="Collapsed"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            <Grid x:Name="UpdateItem" Tag="update" Style="{StaticResource ItemRow}" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <c:PaneIcon Glyph="refresh" Style="{StaticResource ItemIcon}" Foreground="{StaticResource PaneAccentBrush}"/>
                <TextBlock Grid.Column="1" Text="重启并更新" Style="{StaticResource ItemText}" Foreground="{StaticResource PaneAccentBrush}"/>
            </Grid>
            <Border x:Name="UpdateSeparator" Style="{StaticResource Separator}" Visibility="Collapsed"/>

            <Grid Tag="launcher" Style="{StaticResource ItemRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <c:PaneIcon Glyph="search" Style="{StaticResource ItemIcon}"/>
                <TextBlock Grid.Column="1" Text="打开启动器" Style="{StaticResource ItemText}"/>
                <StackPanel x:Name="LauncherKeys" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"/>
            </Grid>
            <Grid Tag="clipboard" Style="{StaticResource ItemRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <c:PaneIcon Glyph="clipboard" Style="{StaticResource ItemIcon}"/>
                <TextBlock Grid.Column="1" Text="打开剪贴板" Style="{StaticResource ItemText}"/>
                <StackPanel x:Name="ClipboardKeys" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"/>
            </Grid>
            <Grid Tag="settings" Style="{StaticResource ItemRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <c:PaneIcon Glyph="gear" Style="{StaticResource ItemIcon}"/>
                <TextBlock Grid.Column="1" Text="设置" Style="{StaticResource ItemText}"/>
            </Grid>

            <Border x:Name="PauseSeparator" Style="{StaticResource Separator}"/>
            <Grid x:Name="PauseItem" Tag="pause" Style="{StaticResource ItemRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <c:PaneIcon x:Name="PauseIcon" Glyph="gesture" Style="{StaticResource ItemIcon}"/>
                <TextBlock Grid.Column="1" Text="暂停手势" Style="{StaticResource ItemText}"/>
                <StackPanel x:Name="PauseKeys" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"/>
            </Grid>

            <Border Style="{StaticResource Separator}"/>
            <Grid Tag="exit" Style="{StaticResource ItemRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <c:PaneIcon Glyph="power" Style="{StaticResource ItemIcon}"/>
                <TextBlock Grid.Column="1" Text="退出 Pane" Style="{StaticResource ItemText}"/>
            </Grid>
        </StackPanel>

        <!-- 样板（不显示）：键帽样式、选中底色、开关打开时的勾的颜色，在代码里取，跟着主题走 -->
        <StackPanel Visibility="Collapsed">
            <Border x:Name="KbdProto" Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}"/></Border>
            <TextBlock x:Name="PlusProto" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            <Border x:Name="HoverProto" Background="{ThemeResource PaneFillHoverBrush}"/>
            <Border x:Name="AccentProto" Background="{StaticResource PaneAccentBrush}"/>
            <Border x:Name="IconProto" Background="{ThemeResource PaneText2Brush}"/>
        </StackPanel>
    </Grid>
</UserControl>
