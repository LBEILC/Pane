<?xml version="1.0" encoding="utf-8"?>
<!--
  安装界面（设计负责人）。520 × 400 的玻璃窗口，四个状态：欢迎 → 安装中 → 装好了 / 没装上。
  只有一个主按钮（主题色实心胶囊），其余是次要按钮；没有「下一步」式的多页向导。
-->
<UserControl
    x:Class="Pane.Views.SetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Pane.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="False">

    <Grid x:Name="Root" Width="520" Height="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：拖动区 + 关闭 -->
        <Grid x:Name="Head" Height="44" VerticalAlignment="Top" Background="Transparent" Canvas.ZIndex="1">
            <Button x:Name="CloseButton" Style="{StaticResource PaneIconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,10,0" Click="OnClose" ToolTipService.ToolTip="{x:Bind loc:Strings.Common_CloseEscapeHint}">
                <c:PaneIcon Glyph="close" Width="16" Height="16" Foreground="{ThemeResource PaneText2Brush}"/>
            </Button>
        </Grid>

        <!-- 欢迎 -->
        <StackPanel x:Name="Welcome" Grid.RowSpan="2" Padding="44,0,44,28" VerticalAlignment="Center">
            <Image x:Name="Logo" Width="72" Height="72" HorizontalAlignment="Center"/>
            <TextBlock Text="Pane" Margin="0,14,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource PaneFontDisplay}" FontSize="{StaticResource PaneTextHero}" FontWeight="SemiBold" Foreground="{ThemeResource PaneText1Brush}"/>
            <TextBlock x:Name="VersionText" Margin="0,2,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText3Brush}"/>
            <TextBlock x:Name="Tagline" Text="{x:Bind loc:Strings.Setup_Tagline}" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText2Brush}"/>

            <Border Margin="0,20,0,0" CornerRadius="{StaticResource PaneRadiusItem}"
                    Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Padding="14,0,10,0" Height="44">
                        <TextBlock Text="{x:Bind loc:Strings.Setup_Autostart}" VerticalAlignment="Center"
                                   FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText1Brush}"/>
                        <ContentControl x:Name="StartHost" HorizontalAlignment="Right" VerticalAlignment="Center" IsTabStop="False"/>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource PaneStrokeBrush}"/>
                    <Grid Padding="14,0,10,0" Height="44">
                        <TextBlock Text="{x:Bind loc:Strings.Setup_DesktopShortcut}" VerticalAlignment="Center"
                                   FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText1Brush}"/>
                        <ContentControl x:Name="DesktopHost" HorizontalAlignment="Right" VerticalAlignment="Center" IsTabStop="False"/>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource PaneStrokeBrush}"/>
                    <!-- 安装位置：新装可以改（选的文件夹里会再建一个 Pane 文件夹）；升级装在原来的位置 -->
                    <Grid Padding="14,8,10,8" MinHeight="44" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind loc:Strings.Setup_InstallLocation}" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText1Brush}"/>
                            <TextBlock x:Name="PathText" Margin="0,2,0,0" TextWrapping="Wrap"
                                       FontFamily="{StaticResource PaneFontMono}" FontSize="11" Foreground="{ThemeResource PaneText3Brush}"/>
                        </StackPanel>
                        <Button x:Name="ChangePath" Grid.Column="1" Style="{StaticResource PaneTextButton}" MinHeight="{StaticResource PaneControlSm}" CornerRadius="14" Padding="14,0,14,0"
                                VerticalAlignment="Center" Content="{x:Bind loc:Strings.Common_Change}" Click="OnChangePath"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="NoteText" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText2Brush}"/>
            <Button x:Name="InstallButton" Style="{StaticResource PanePrimaryButton}" Margin="0,18,0,0" MinWidth="200" HorizontalAlignment="Center" Click="OnInstall"/>
            <TextBlock x:Name="WhereText" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
        </StackPanel>

        <!-- 安装中 -->
        <StackPanel x:Name="Working" Grid.RowSpan="2" Padding="44,0,44,44" VerticalAlignment="Center" Visibility="Collapsed">
            <Image x:Name="WorkingLogo" Width="56" Height="56" HorizontalAlignment="Center"/>
            <TextBlock x:Name="WorkingTitle" Margin="0,16,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource PaneFontDisplay}" FontSize="{StaticResource PaneTextTitle}" FontWeight="SemiBold" Foreground="{ThemeResource PaneText1Brush}"/>
            <Grid Margin="0,18,0,0" Width="300" Height="6" HorizontalAlignment="Center">
                <Border CornerRadius="3" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1"/>
                <Border x:Name="ProgressFill" CornerRadius="3" Width="0" HorizontalAlignment="Left" Background="{StaticResource PaneAccentBrush}"/>
            </Grid>
            <TextBlock x:Name="StepText" Margin="0,10,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText3Brush}"/>
        </StackPanel>

        <!-- 装好了 -->
        <StackPanel x:Name="Done" Grid.RowSpan="2" Padding="44,0,44,36" VerticalAlignment="Center" Visibility="Collapsed">
            <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Background="{StaticResource PaneAccentBrush}">
                <c:PaneIcon Glyph="check" Width="28" Height="28" StrokeWidth="2.4" Foreground="White"/>
            </Border>
            <TextBlock x:Name="DoneTitle" Margin="0,16,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource PaneFontDisplay}" FontSize="{StaticResource PaneTextTitle}" FontWeight="SemiBold" Foreground="{ThemeResource PaneText1Brush}"/>
            <StackPanel Margin="0,16,0,0" Spacing="8" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Border Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}" Text="Alt"/></Border>
                    <TextBlock Text="+" VerticalAlignment="Center" Foreground="{ThemeResource PaneText3Brush}" FontFamily="{StaticResource PaneFontUi}"/>
                    <Border Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}" Text="{x:Bind loc:Strings.Common_SpaceKey}"/></Border>
                    <TextBlock Text="{x:Bind loc:Strings.Setup_OpenLauncher}" Margin="6,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText2Brush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Border Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}" Text="Alt"/></Border>
                    <TextBlock Text="+" VerticalAlignment="Center" Foreground="{ThemeResource PaneText3Brush}" FontFamily="{StaticResource PaneFontUi}"/>
                    <Border Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}" Text="V"/></Border>
                    <TextBlock Text="{x:Bind loc:Strings.Setup_OpenClipboard}" Margin="6,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText2Brush}"/>
                </StackPanel>
                <TextBlock Text="{x:Bind loc:Strings.Setup_GestureHint}" HorizontalAlignment="Center"
                           FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText3Brush}"/>
            </StackPanel>
            <StackPanel Margin="0,24,0,0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Style="{StaticResource PanePrimaryButton}" MinWidth="160" Content="{x:Bind loc:Strings.Setup_OpenPane}" Click="OnLaunch"/>
                <Button Style="{StaticResource PaneTextButton}" MinHeight="{StaticResource PaneControlLg}" Padding="20,0,20,0" CornerRadius="20" FontSize="{StaticResource PaneTextMd}" Content="{x:Bind loc:Strings.Common_Done}" Click="OnClose"/>
            </StackPanel>
        </StackPanel>

        <!-- 没装上 -->
        <StackPanel x:Name="Failed" Grid.RowSpan="2" Padding="44,0,44,40" VerticalAlignment="Center" Visibility="Collapsed">
            <c:PaneIcon Glyph="warn" Width="40" Height="40" HorizontalAlignment="Center" Foreground="{StaticResource PaneWarningBrush}"/>
            <TextBlock x:Name="FailedTitle" Margin="0,14,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource PaneFontDisplay}" FontSize="{StaticResource PaneTextTitle}" FontWeight="SemiBold" Foreground="{ThemeResource PaneText1Brush}"/>
            <TextBlock x:Name="ErrorText" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText2Brush}"/>
            <TextBlock x:Name="KeptText" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText3Brush}"/>
            <StackPanel Margin="0,24,0,0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Style="{StaticResource PanePrimaryButton}" MinWidth="140" Content="{x:Bind loc:Strings.Common_TryOnceMore}" Click="OnInstall"/>
                <Button Style="{StaticResource PaneTextButton}" MinHeight="{StaticResource PaneControlLg}" Padding="20,0,20,0" CornerRadius="20" FontSize="{StaticResource PaneTextMd}" Content="{x:Bind loc:Strings.Common_Close}" Click="OnClose"/>
            </StackPanel>
        </StackPanel>

        <!-- 样板（隐藏）：开关要的画刷从这里读，不按名字查资源 -->
        <Border x:Name="FillProto" Visibility="Collapsed" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}"/>
        <Border x:Name="AccentProto" Visibility="Collapsed" Background="{StaticResource PaneAccentBrush}"/>
        <TextBlock x:Name="DimProto" Visibility="Collapsed" Foreground="{ThemeResource PaneText3Brush}"/>
    </Grid>
</UserControl>
