<?xml version="1.0" encoding="utf-8"?>
<!--
  卸载界面（设计负责人）。和安装界面同一个窗口大小、同样的结构：确认 → 卸载中 → 卸载完 / 没卸干净。
  「同时删除我的数据」默认关：误删剪贴板历史和手势比多留几 MB 文件糟得多。
-->
<UserControl
    x:Class="Pane.Views.UninstallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="False">

    <Grid x:Name="Root" Width="520" Height="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Head" Height="44" VerticalAlignment="Top" Background="Transparent" Canvas.ZIndex="1">
            <Button x:Name="CloseButton" Style="{StaticResource PaneIconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,10,0" Click="OnClose" ToolTipService.ToolTip="关闭（Esc）">
                <c:PaneIcon Glyph="close" Width="16" Height="16" Foreground="{ThemeResource PaneText2Brush}"/>
            </Button>
        </Grid>

        <!-- 确认 -->
        <StackPanel x:Name="Ask" Grid.RowSpan="2" Padding="44,0,44,32" VerticalAlignment="Center">
            <Image x:Name="Logo" Width="64" Height="64" HorizontalAlignment="Center"/>
            <TextBlock x:Name="AskTitle" Margin="0,16,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource PaneFontDisplay}" FontSize="{StaticResource PaneTextHero}" FontWeight="SemiBold" Foreground="{ThemeResource PaneText1Brush}"/>
            <TextBlock Text="会删掉程序、开始菜单和桌面上的快捷方式，以及开机启动项。" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText2Brush}"/>
            <Border Margin="0,20,0,0" CornerRadius="{StaticResource PaneRadiusItem}"
                    Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                <Grid Padding="14,10,10,10" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="同时删除我的数据" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText1Brush}"/>
                        <TextBlock x:Name="DataText" Margin="0,2,0,0" TextWrapping="Wrap" LineHeight="18"
                                   FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
                    </StackPanel>
                    <ContentControl x:Name="DataHost" Grid.Column="1" VerticalAlignment="Center" IsTabStop="False"/>
                </Grid>
            </Border>
            <TextBlock x:Name="RunningText" Text="Pane 正在运行，卸载时会先让它退出" Margin="0,12,0,0" HorizontalAlignment="Center" Visibility="Collapsed"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText2Brush}"/>
            <StackPanel Margin="0,22,0,0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button x:Name="UninstallButton" Style="{StaticResource PanePrimaryButton}" Background="{StaticResource PaneDangerBrush}" MinWidth="140" Content="卸载" Click="OnUninstall"/>
                <Button Style="{StaticResource PaneTextButton}" MinHeight="{StaticResource PaneControlLg}" Padding="20,0,20,0" CornerRadius="20" FontSize="{StaticResource PaneTextMd}" Content="取消" Click="OnClose"/>
            </StackPanel>
        </StackPanel>

        <!-- 卸载中 -->
        <StackPanel x:Name="Working" Grid.RowSpan="2" Padding="44,0,44,44" VerticalAlignment="Center" Visibility="Collapsed">
            <Image x:Name="WorkingLogo" Width="56" Height="56" HorizontalAlignment="Center"/>
            <TextBlock Text="正在卸载…" Margin="0,16,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource PaneFontDisplay}" FontSize="{StaticResource PaneTextTitle}" FontWeight="SemiBold" Foreground="{ThemeResource PaneText1Brush}"/>
            <Grid Margin="0,18,0,0" Width="300" Height="6" HorizontalAlignment="Center">
                <Border CornerRadius="3" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1"/>
                <Border x:Name="ProgressFill" CornerRadius="3" Width="0" HorizontalAlignment="Left" Background="{ThemeResource PaneText2Brush}"/>
            </Grid>
            <TextBlock x:Name="StepText" Margin="0,10,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText3Brush}"/>
        </StackPanel>

        <!-- 卸载完 -->
        <StackPanel x:Name="Done" Grid.RowSpan="2" Padding="44,0,44,40" VerticalAlignment="Center" Visibility="Collapsed">
            <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                <c:PaneIcon Glyph="check" Width="28" Height="28" StrokeWidth="2.4" Foreground="{ThemeResource PaneText1Brush}"/>
            </Border>
            <TextBlock Text="Pane 已卸载" Margin="0,16,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource PaneFontDisplay}" FontSize="{StaticResource PaneTextTitle}" FontWeight="SemiBold" Foreground="{ThemeResource PaneText1Brush}"/>
            <TextBlock x:Name="DoneText" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText2Brush}"/>
            <Button Style="{StaticResource PaneTextButton}" Margin="0,24,0,0" MinHeight="{StaticResource PaneControlLg}" MinWidth="120" Padding="20,0,20,0" CornerRadius="20" HorizontalAlignment="Center"
                    FontSize="{StaticResource PaneTextMd}" Content="完成" Click="OnClose"/>
        </StackPanel>

        <!-- 没卸干净 -->
        <StackPanel x:Name="Failed" Grid.RowSpan="2" Padding="44,0,44,40" VerticalAlignment="Center" Visibility="Collapsed">
            <c:PaneIcon Glyph="warn" Width="40" Height="40" HorizontalAlignment="Center" Foreground="{StaticResource PaneWarningBrush}"/>
            <TextBlock Text="没有卸载干净" Margin="0,14,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource PaneFontDisplay}" FontSize="{StaticResource PaneTextTitle}" FontWeight="SemiBold" Foreground="{ThemeResource PaneText1Brush}"/>
            <TextBlock x:Name="ErrorText" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText2Brush}"/>
            <StackPanel Margin="0,24,0,0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Style="{StaticResource PanePrimaryButton}" MinWidth="140" Content="再试一次" Click="OnUninstall"/>
                <Button Style="{StaticResource PaneTextButton}" MinHeight="{StaticResource PaneControlLg}" Padding="20,0,20,0" CornerRadius="20" FontSize="{StaticResource PaneTextMd}" Content="关闭" Click="OnClose"/>
            </StackPanel>
        </StackPanel>

        <Border x:Name="FillProto" Visibility="Collapsed" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}"/>
        <Border x:Name="AccentProto" Visibility="Collapsed" Background="{StaticResource PaneAccentBrush}"/>
    </Grid>
</UserControl>
