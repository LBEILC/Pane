<?xml version="1.0" encoding="utf-8"?>
<!--
  到点前提醒（设计负责人，058）。照原型 prototype/timer.html #rm（docs/design.md「定时关机」）。
  320 × 132，工作区右下角，不抢焦点、可点、置顶；倒数 60 秒，「推迟 10 分钟」和「取消」。
-->
<UserControl
    x:Class="Pane.Views.PowerReminderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Pane.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="False">

    <StackPanel Padding="16,14,16,14">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <c:PaneIcon x:Name="ActionIcon" Glyph="power" Width="16" Height="16" VerticalAlignment="Center" Foreground="{ThemeResource PaneText1Brush}"/>
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText2Brush}"/>
        </StackPanel>
        <TextBlock x:Name="CountText" Margin="0,2,0,10" FontFamily="{StaticResource PaneFontDisplay}" FontSize="34" FontWeight="SemiBold" Foreground="{ThemeResource PaneText1Brush}"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Style="{StaticResource PaneTextButton}" Height="{StaticResource PaneControlSm}" VerticalAlignment="Center" Content="{x:Bind loc:Strings.Reminder_Postpone}" Click="OnPostpone"/>
            <Button Style="{StaticResource PanePrimaryButton}" Height="{StaticResource PaneControlSm}" MinHeight="0" CornerRadius="14" Padding="16,0,16,0" FontSize="{StaticResource PaneTextSm}"
                    Background="{StaticResource PaneAccentBrush}" Content="{x:Bind loc:Strings.Common_Cancel}" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</UserControl>
