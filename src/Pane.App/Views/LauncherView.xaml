<?xml version="1.0" encoding="utf-8"?>
<!--
  启动器（设计负责人）。照原型 prototype/launcher.html #lx（2026-10-29 新排法，docs/design.md「启动器排法与二级窗口」）。
  宽 592；搜索行 60；结果区最高 452，内边距 4 8 8；格子一行 7 个（82 × 92，图标 40，名字最多两行）；列表行 48；底部提示栏 34。
  顺序：算式 → 应用（格子）→ 动作行（格子）→ 文件（列表，前 3 个 + 「查看全部」）。空输入是「最近使用 / 已固定」格子；有附件时是动作列表。
-->
<UserControl
    x:Class="Pane.Views.LauncherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:launcher="using:Pane.Views.Launcher"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 列表行（文件、常用、附件动作）：图标 32 | 名字 + 路径 | 热键 -->
            <DataTemplate x:Key="RowTemplate" x:DataType="launcher:LauncherRow">
                <Grid Height="48" Padding="12,0,12,0" ColumnSpacing="12" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="32" Height="32">
                        <Border CornerRadius="8" Background="{x:Bind Gradient}" Visibility="{x:Bind ColoredVisibility}"/>
                        <Border CornerRadius="8" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1" Visibility="{x:Bind PlainVisibility}"/>
                        <c:PaneIcon Width="17" Height="17" Glyph="{x:Bind Glyph}" StrokeWidth="2" Foreground="White" Visibility="{x:Bind ColoredVisibility}"/>
                        <c:PaneIcon Width="17" Height="17" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource PaneText2Brush}" Visibility="{x:Bind PlainVisibility}"/>
                        <Image Width="32" Height="32" Source="{x:Bind Picture}" Visibility="{x:Bind PictureVisibility}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock c:MatchText.Source="{x:Bind Match}"
                                   FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}"
                                   Foreground="{ThemeResource PaneText1Brush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}"
                                   FontFamily="{x:Bind SubtitleFont}" FontSize="{StaticResource PaneTextXs}"
                                   Foreground="{ThemeResource PaneText3Brush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Visibility="{x:Bind HotkeyVisibility}" c:KeyCombo.Text="{x:Bind Hotkey}"/>
                </Grid>
            </DataTemplate>

            <!-- 「在文件窗口里查看全部 N 个」：矮一点的行，次要文字 -->
            <DataTemplate x:Key="MoreTemplate" x:DataType="launcher:LauncherRow">
                <Grid Height="38" Padding="12,0,12,0" ColumnSpacing="12" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <c:PaneIcon Width="16" Height="16" Glyph="external" Foreground="{ThemeResource PaneText3Brush}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center"
                               FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}"
                               Foreground="{ThemeResource PaneText2Brush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <Border Grid.Column="2" Style="{StaticResource PaneKbdBorder}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PaneKbdText}" Text="Tab"/>
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- 算式：大号结果 + 说明 -->
            <DataTemplate x:Key="CalcTemplate" x:DataType="launcher:LauncherRow">
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="12,10,12,12" Background="Transparent">
                    <TextBlock Text="{x:Bind CalcText}" FontFamily="{StaticResource PaneFontDisplay}" FontSize="{StaticResource PaneTextHero}" FontWeight="SemiBold"
                               Foreground="{ThemeResource PaneText1Brush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="440"/>
                    <TextBlock Text="Enter 复制结果" VerticalAlignment="Bottom" Margin="0,0,0,4"
                               FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText3Brush}"/>
                </StackPanel>
            </DataTemplate>

            <!-- 格子：图标 40 + 名字（最多两行）；动作格子是中性底，按住 Alt 左上角出数字 -->
            <DataTemplate x:Key="TileTemplate" x:DataType="launcher:LauncherRow">
                <Grid Width="82" Height="92" Padding="4,10,4,0" Background="Transparent">
                    <StackPanel Spacing="6">
                        <Grid Width="40" Height="40">
                            <Border CornerRadius="10" Background="{x:Bind Gradient}" BorderBrush="#2EFFFFFF" BorderThickness="1" Visibility="{x:Bind ColoredVisibility}"/>
                            <Border CornerRadius="10" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1" Visibility="{x:Bind PlainVisibility}"/>
                            <c:PaneIcon Width="22" Height="22" Glyph="{x:Bind Glyph}" StrokeWidth="1.9" Foreground="White" Visibility="{x:Bind ColoredVisibility}"/>
                            <c:PaneIcon Width="22" Height="22" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource PaneText1Brush}" Visibility="{x:Bind PlainVisibility}"/>
                            <Image Width="40" Height="40" Source="{x:Bind Picture}" Visibility="{x:Bind PictureVisibility}"/>
                        </Grid>
                        <TextBlock c:MatchText.Source="{x:Bind Match}" HorizontalAlignment="Center" TextAlignment="Center"
                                   FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" LineHeight="15.6"
                                   Foreground="{ThemeResource PaneText1Brush}" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,-4,0,0" MinWidth="16" Height="16" Padding="4,0,4,0"
                            CornerRadius="5" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1"
                            Visibility="{x:Bind NumberVisibility, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Number}" FontFamily="{StaticResource PaneFontUi}" FontSize="10" LineHeight="14" TextAlignment="Center"
                                   Foreground="{ThemeResource PaneText2Brush}"/>
                    </Border>
                </Grid>
            </DataTemplate>

            <launcher:LauncherRowSelector x:Key="RowSelector" Row="{StaticResource RowTemplate}" More="{StaticResource MoreTemplate}"/>

            <DataTemplate x:Key="ListSectionTemplate" x:DataType="launcher:LauncherSection">
                <StackPanel>
                    <TextBlock Style="{StaticResource PaneGroupLabel}" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplateSelector="{StaticResource RowSelector}" IsTabStop="False"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="TileSectionTemplate" x:DataType="launcher:LauncherSection">
                <StackPanel>
                    <TextBlock Style="{StaticResource PaneGroupLabel}" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource TileTemplate}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="82" ItemHeight="92" MaximumRowsOrColumns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="CalcSectionTemplate" x:DataType="launcher:LauncherSection">
                <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource CalcTemplate}" IsTabStop="False" Margin="0,4,0,0"/>
            </DataTemplate>

            <launcher:LauncherSectionSelector x:Key="SectionSelector"
                List="{StaticResource ListSectionTemplate}" Tiles="{StaticResource TileSectionTemplate}" Calc="{StaticResource CalcSectionTemplate}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root" Width="592" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索行：输入框以外的部分（放大镜、Pane 标签、两侧留白）可拖动整个启动器，双击恢复默认位置（宿主处理） -->
        <Grid x:Name="SearchRow" Padding="20,0,20,0" ColumnSpacing="12" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:PaneIcon Glyph="search" Width="22" Height="22" VerticalAlignment="Center" Foreground="{ThemeResource PaneText2Brush}"/>
            <!-- 附件：刚复制的内容，或从剪贴板交过来的条目（原型 .attach） -->
            <Border x:Name="AttachChip" Grid.Column="1" Height="30" MaxWidth="220" Padding="9,0,4,0" VerticalAlignment="Center" Visibility="Collapsed"
                    CornerRadius="15" Background="{ThemeResource PaneFillSelectedBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <c:PaneIcon x:Name="AttachIcon" Width="15" Height="15" VerticalAlignment="Center" Foreground="{ThemeResource PaneText2Brush}"/>
                    <TextBlock x:Name="AttachText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText1Brush}"/>
                    <Button Grid.Column="2" Style="{StaticResource PaneIconButton}" Width="22" Height="22" CornerRadius="11"
                            Click="OnRemoveAttachment" ToolTipService.ToolTip="去掉附件（Esc）">
                        <c:PaneIcon Glyph="close" Width="13" Height="13" Foreground="{ThemeResource PaneText2Brush}"/>
                    </Button>
                </Grid>
            </Border>
            <TextBox x:Name="Input" Grid.Column="2" VerticalAlignment="Center" MinHeight="0" Padding="0"
                     PlaceholderText="搜索应用、文件，或输入任何文字"
                     FontFamily="{StaticResource PaneFontDisplay}" FontSize="{StaticResource PaneTextSearch}"
                     SelectionHighlightColor="{StaticResource PaneAccentBrush}"
                     IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                     TextChanged="OnTextChanged" PreviewKeyDown="OnInputKeyDown" PreviewKeyUp="OnInputKeyUp" LostFocus="OnInputLostFocus"/>
            <Border Grid.Column="3" VerticalAlignment="Center" Height="22" Padding="9,0,9,0" CornerRadius="11"
                    Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                <TextBlock Text="Pane" VerticalAlignment="Center" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}"
                           CharacterSpacing="40" Foreground="{ThemeResource PaneText2Brush}"/>
            </Border>
        </Grid>

        <!-- 结果区：上沿一条分隔线；滚动条隐藏 -->
        <Grid x:Name="ResultsArea" Grid.Row="1" Visibility="Collapsed">
            <Border Height="1" VerticalAlignment="Top" Background="{ThemeResource PaneStrokeBrush}"/>
            <ScrollViewer x:Name="Scroller" Margin="0,1,0,0" MaxHeight="452"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
                <Grid x:Name="ResultsContent" Padding="8,4,8,8">
                    <!-- 选中高亮画在这一层（Composition），滑动跟随选中项 -->
                    <Canvas x:Name="HighlightLayer" IsHitTestVisible="False"/>
                    <ItemsControl x:Name="Sections" ItemTemplateSelector="{StaticResource SectionSelector}" IsTabStop="False"/>
                </Grid>
            </ScrollViewer>
            <!-- AI 结果卡片：代替结果列表 -->
            <c:AiCard x:Name="Card" Margin="20,16,20,12" Visibility="Collapsed"/>
        </Grid>

        <!-- 底部提示栏：选中的那一项按 Enter / Tab / Ctrl+Enter 会做什么 -->
        <Grid x:Name="Foot" Grid.Row="2" Height="34" Padding="20,0,20,0" ColumnSpacing="14" Visibility="Collapsed"
              BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FootWhat" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
            <c:WrapPanel x:Name="FootKeys" Grid.Column="1" VerticalAlignment="Center" HorizontalSpacing="12" VerticalSpacing="0"/>
        </Grid>

        <!-- 样板（按键提示用；NativeAOT 下不按名字查资源） -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="HintLabelProto" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            <Border x:Name="KbdProto" Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}"/></Border>
        </StackPanel>
    </Grid>
</UserControl>
