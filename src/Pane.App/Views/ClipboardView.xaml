<?xml version="1.0" encoding="utf-8"?>
<!--
  剪贴板（设计负责人）。照原型 prototype/index.html #clipboard 和 style.css「剪贴板」一节。
  宽 372、高 640：搜索框 → 类型筛选 → 分组列表（已固定 / 今天 / 更早）→ 底部快捷键提示。
-->
<UserControl
    x:Class="Pane.Views.ClipboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:clip="using:Pane.Views.Clipboard"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="False">

    <UserControl.Resources>
        <!-- 一条记录：类型图标 28 | 内容 + 元信息 -->
        <DataTemplate x:Key="ClipTemplate" x:DataType="clip:ClipRow">
            <Grid Padding="12,10,12,10" ColumnSpacing="10" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" VerticalAlignment="Top" CornerRadius="8"
                        Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                    <c:PaneIcon Glyph="{x:Bind TypeGlyph}" Width="15" Height="15" Foreground="{ThemeResource PaneText2Brush}"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <!-- 文本 / 链接：最多两行 -->
                    <TextBlock clip:ClipMatch.Source="{x:Bind Body}" Visibility="{x:Bind TextVisibility}"
                               FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" LineHeight="20"
                               Foreground="{ThemeResource PaneText1Brush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <!-- 代码：等宽 -->
                    <TextBlock clip:ClipMatch.Source="{x:Bind Body}" Visibility="{x:Bind CodeVisibility}"
                               FontFamily="{StaticResource PaneFontMono}" FontSize="12.5" LineHeight="19"
                               Foreground="{ThemeResource PaneText1Brush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <!-- 颜色：色块 + 色值 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ColorVisibility}">
                        <Border Width="16" Height="16" CornerRadius="5" Background="{x:Bind Swatch}" BorderBrush="#26000000" BorderThickness="1"/>
                        <TextBlock clip:ClipMatch.Source="{x:Bind Body}" VerticalAlignment="Center"
                                   FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText1Brush}"/>
                    </StackPanel>
                    <!-- 图片（以及复制的单个图片文件）：按原图比例显示，宽图铺满一行、竖图限高靠左（2026-11-01 用户：一条横条看不出竖图） -->
                    <Border Width="{x:Bind ThumbWidth}" Height="{x:Bind ThumbHeight}" HorizontalAlignment="{x:Bind ThumbAlign}" CornerRadius="8"
                            Background="{x:Bind Thumb}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1"
                            Visibility="{x:Bind ThumbVisibility}"/>
                    <!-- 文件：每行一个文件名 -->
                    <ItemsControl ItemsSource="{x:Bind FileLines}" Visibility="{x:Bind FilesVisibility}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="clip:ClipText">
                                <TextBlock clip:ClipMatch.Source="{x:Bind}" Margin="0,0,0,2"
                                           FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}"
                                           Foreground="{ThemeResource PaneText1Brush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 元信息：图钉、来源小图标、来源 · 时间；右端 Alt+数字 / 操作按钮 -->
                    <Grid Margin="0,4,0,0" ColumnSpacing="6" MinHeight="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <c:PaneIcon Glyph="pin" IsFilled="True" Width="12" Height="12" VerticalAlignment="Center"
                                    Foreground="{ThemeResource PaneText2Brush}" Visibility="{x:Bind PinVisibility}"/>
                        <Border Grid.Column="1" Width="14" Height="14" CornerRadius="4" VerticalAlignment="Center"
                                Background="{x:Bind SourceBrush}" Visibility="{x:Bind SourceVisibility}">
                            <c:PaneIcon Glyph="{x:Bind SourceGlyph}" Width="9" Height="9" StrokeWidth="2.4" Foreground="White"/>
                        </Border>
                        <!-- 真实来源图标：程序自己的图标，不加底板 -->
                        <Image Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center" Stretch="Uniform"
                               Source="{x:Bind SourcePicture}" Visibility="{x:Bind SourcePictureVisibility}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind MetaText}" VerticalAlignment="Center"
                                   FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}"
                                   Foreground="{ThemeResource PaneText3Brush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <Grid Grid.Column="3" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" c:KeyCombo.Text="{x:Bind Hotkey}"
                                        Visibility="{x:Bind HotkeyVisibility}" Opacity="{x:Bind HotkeyOpacity, Mode=OneWay}"/>
                            <StackPanel Orientation="Horizontal" Spacing="2" Opacity="{x:Bind ActionsOpacity, Mode=OneWay}"
                                        IsHitTestVisible="{x:Bind ActionsHitTest, Mode=OneWay}">
                                <Button Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlXs}" Height="{StaticResource PaneControlXs}" CornerRadius="7"
                                        Click="{x:Bind Send}" ToolTipService.ToolTip="交给启动器（Tab）">
                                    <c:PaneIcon Glyph="R" Width="14" Height="14" Foreground="{ThemeResource PaneText2Brush}"/>
                                </Button>
                                <Button Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlXs}" Height="{StaticResource PaneControlXs}" CornerRadius="7"
                                        Click="{x:Bind TogglePin}" ToolTipService.ToolTip="{x:Bind PinTip}">
                                    <c:PaneIcon Glyph="pin" IsFilled="{x:Bind Pinned}" Width="14" Height="14" Foreground="{ThemeResource PaneText2Brush}"/>
                                </Button>
                                <Button Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlXs}" Height="{StaticResource PaneControlXs}" CornerRadius="7"
                                        Click="{x:Bind Delete}" ToolTipService.ToolTip="删除">
                                    <c:PaneIcon Glyph="close" Width="14" Height="14" Foreground="{ThemeResource PaneText2Brush}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate" x:DataType="clip:ClipSection">
            <StackPanel>
                <TextBlock Style="{StaticResource PaneGroupLabel}" Text="{x:Bind Label}"/>
                <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ClipTemplate}" IsTabStop="False"/>
            </StackPanel>
        </DataTemplate>

        <!-- 筛选小标签：选中用正文色加粗，未选中用次要文字色（透明度近似 text-2 / text-1） -->
        <DataTemplate x:Key="ChipTemplate" x:DataType="clip:ChipItem">
            <Grid Height="28" Padding="12,0,12,0" Background="Transparent">
                <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"
                           FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}"
                           Foreground="{ThemeResource PaneText1Brush}"
                           FontWeight="{x:Bind Weight, Mode=OneWay}" Opacity="{x:Bind TextOpacity, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="FootText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PaneFontUi}"/>
            <Setter Property="FontSize" Value="{StaticResource PaneTextXs}"/>
            <Setter Property="Foreground" Value="{ThemeResource PaneText3Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Width="372" Height="640">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索框：聚焦时外圈一道主题色光环（主题色只用于焦点） -->
        <Grid Padding="16,16,16,8">
            <Border x:Name="FocusRing" Margin="-2" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource PaneAccentBrush}" Opacity="0"/>
            <Border Height="32" Padding="10,0,10,0" CornerRadius="{StaticResource PaneRadiusControl}"
                    Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <c:PaneIcon Glyph="search" Width="15" Height="15" VerticalAlignment="Center" Foreground="{ThemeResource PaneText3Brush}"/>
                    <TextBox x:Name="Input" Grid.Column="1" VerticalAlignment="Center" MinHeight="0" Padding="0"
                             PlaceholderText="搜索剪贴板" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}"
                             SelectionHighlightColor="{StaticResource PaneAccentBrush}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                             TextChanged="OnTextChanged" PreviewKeyDown="OnInputKeyDown"
                             GotFocus="OnInputFocus" LostFocus="OnInputFocus"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 类型筛选：选中项高亮滑动 -->
        <Grid Grid.Row="1" Padding="16,0,16,8">
            <Canvas x:Name="ChipHighlightLayer" IsHitTestVisible="False"/>
            <ItemsControl x:Name="Chips" ItemTemplate="{StaticResource ChipTemplate}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

        <!-- 列表 -->
        <Grid Grid.Row="2">
            <Border Height="1" VerticalAlignment="Top" Background="{ThemeResource PaneStrokeBrush}"/>
            <ScrollViewer x:Name="Scroller" Margin="0,1,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
                <Grid x:Name="ListContent" Padding="8,4,8,8">
                    <Canvas x:Name="HighlightLayer" IsHitTestVisible="False"/>
                    <ItemsControl x:Name="Sections" ItemTemplate="{StaticResource SectionTemplate}" IsTabStop="False"/>
                    <TextBlock x:Name="Empty" Text="没有匹配的记录" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,24,0,24"
                               FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText3Brush}"/>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 快捷键提示 -->
        <Grid Grid.Row="3">
            <Border Height="1" VerticalAlignment="Top" Background="{ThemeResource PaneStrokeBrush}"/>
            <c:WrapPanel x:Name="Foot" Margin="16,9,16,9" HorizontalSpacing="12" VerticalSpacing="4"/>
            <!-- 快捷键提示的样板（隐藏），代码照它的样式生成 -->
            <TextBlock x:Name="HintLabelProto" Visibility="Collapsed" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            <Border x:Name="KbdProto" Visibility="Collapsed" Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}"/></Border>
        </Grid>
    </Grid>
</UserControl>
