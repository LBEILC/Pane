<?xml version="1.0" encoding="utf-8"?>
<!--
  分词窗口（二级窗口，设计负责人，093）。照原型 prototype/words.html #ww（docs/design.md「分词」）。
  宽 600。头 56：窗口种类「分词」+ 来源小字，右边全选、关闭；词块区（最高 300，超出滚动）；
  操作行（组件库 .w2-actions）：选中文字的预览 / 鼠标用法说明、拼接方式（选了不挨着的两段以上才出现）、交给启动器、主按钮「复制 Enter」；
  底 38：键盘提示（键帽）+「已选 N 块 · M 字」。
  键盘：←→↑↓ 移动、空格选 / 取消、Shift+方向连选、Ctrl+A 全选、Enter / Ctrl+C 复制、Tab 交给启动器、Esc 先清空选中再关闭、Ctrl+W 关。
-->
<UserControl
    x:Class="Pane.Views.WordsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Pane.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="True" UseSystemFocusVisuals="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- 头 -->
        <Grid x:Name="Head" Padding="18,0,10,0" ColumnSpacing="10" Background="Transparent" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Height="28" Padding="8,0,10,0" CornerRadius="14" VerticalAlignment="Center"
                    Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:PaneIcon Glyph="words" Width="15" Height="15" VerticalAlignment="Center" Foreground="{ThemeResource PaneText2Brush}"/>
                    <TextBlock Text="{x:Bind loc:Strings.Module_Words_Name}" VerticalAlignment="Center" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText2Brush}"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="SourceText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            <Button Grid.Column="2" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}" Click="OnSelectAll" IsTabStop="False"
                    ToolTipService.ToolTip="{x:Bind loc:Strings.Words_SelectAllHint}">
                <c:PaneIcon Glyph="check" Width="16" Height="16"/>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}" Click="OnClose" IsTabStop="False"
                    ToolTipService.ToolTip="{x:Bind loc:Strings.Words_CloseHint}">
                <c:PaneIcon Glyph="close" Width="16" Height="16"/>
            </Button>
        </Grid>

        <!-- 词块 -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
            <StackPanel Padding="18,16,18,16" Spacing="10">
                <c:WrapPanel x:Name="Chips" HorizontalSpacing="6" VerticalSpacing="6" Background="Transparent"
                             PointerPressed="OnChipsPressed" PointerMoved="OnChipsMoved" PointerReleased="OnChipsReleased" PointerCaptureLost="OnChipsCaptureLost"/>
                <TextBlock x:Name="Notice" Visibility="Collapsed" TextWrapping="Wrap" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 操作行（组件库 .w2-actions） -->
        <Grid Grid.Row="2" MinHeight="52" Padding="18,0,12,0" ColumnSpacing="10" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PickText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText3Brush}"/>
            <Border x:Name="JoinHost" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed" ToolTipService.ToolTip="{x:Bind loc:Strings.Words_JoinHint}"/>
            <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource PaneTextButton}" Height="{StaticResource PaneControlSm}" CornerRadius="14" Click="OnSend" IsTabStop="False"
                    ToolTipService.ToolTip="Tab">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:PaneIcon Glyph="search" Width="14" Height="14" VerticalAlignment="Center" Foreground="{ThemeResource PaneText2Brush}"/>
                    <TextBlock Text="{x:Bind loc:Strings.Clipboard_SendToLauncher}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CopyButton" Grid.Column="3" Style="{StaticResource PanePrimaryButton}" Height="{StaticResource PaneControlMd}" MinHeight="0" CornerRadius="16" Padding="18,0,14,0"
                    FontSize="{StaticResource PaneTextSm}" Click="OnCopy" IsTabStop="False" ToolTipService.ToolTip="Enter">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind loc:Strings.Common_Copy}" VerticalAlignment="Center"/>
                    <TextBlock Text="Enter" VerticalAlignment="Center" Opacity="0.7" FontSize="{StaticResource PaneTextXs}" FontWeight="Normal"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 底：键盘提示 + 已选 -->
        <Grid Grid.Row="3" Padding="16,0,16,0" ColumnSpacing="12" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:WrapPanel x:Name="Foot" VerticalAlignment="Center" HorizontalSpacing="16" VerticalSpacing="4"/>
            <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
        </Grid>

        <!-- 样板：代码从这些隐藏元素的强类型属性取样式和颜色（NativeAOT） -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="HintLabelProto" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            <Border x:Name="KbdProto" Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}"/></Border>
            <TextBlock x:Name="SmallProto" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
            <TextBlock x:Name="SmallStrongProto" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText1Brush}"/>
            <TextBlock x:Name="ChipProto" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText1Brush}"/>
            <TextBlock x:Name="Text2Proto" Foreground="{ThemeResource PaneText2Brush}"/>
            <TextBlock x:Name="Text3Proto" Foreground="{ThemeResource PaneText3Brush}"/>
            <Border x:Name="FillProto" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}"/>
            <Border x:Name="HoverProto" Background="{ThemeResource PaneFillHoverBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
