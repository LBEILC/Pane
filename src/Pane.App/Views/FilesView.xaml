<?xml version="1.0" encoding="utf-8"?>
<!--
  文件窗口（二级窗口，设计负责人）。照原型 prototype/launcher.html #fw（docs/design.md「文件窗口」）。
  默认 880 × 580，可改大小（最小 640 × 420）。顶栏 56；左侧分类 116；中间结果（行高 50）；右侧预览 268（可关）；底栏 38。
  失去焦点不关；Esc 只清空输入；关闭按钮 / Ctrl+W / Alt+F4 关。
-->
<UserControl
    x:Class="Pane.Views.FilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:files="using:Pane.Views.Files"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="False">

    <UserControl.Resources>
        <DataTemplate x:Key="CategoryTemplate" x:DataType="files:CategoryItem">
            <Grid Height="32" Padding="10,0,10,0" Margin="0,0,0,2" Background="Transparent" CornerRadius="{StaticResource PaneRadiusControl}">
                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="{x:Bind Weight, Mode=OneWay}" Opacity="{x:Bind TextOpacity, Mode=OneWay}"
                           FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText1Brush}"/>
                <TextBlock Text="{x:Bind CountText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontFamily="{StaticResource PaneFontUi}" FontSize="10" Foreground="{ThemeResource PaneText3Brush}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FileTemplate" x:DataType="files:FileRow">
            <Grid Height="50" Padding="10,0,10,0" ColumnSpacing="12" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32">
                    <Border CornerRadius="8" Background="{x:Bind Tile}" Visibility="{x:Bind TileVisibility, Mode=OneWay}">
                        <c:PaneIcon Width="17" Height="17" Glyph="{x:Bind Glyph}" StrokeWidth="2" Foreground="White"/>
                    </Border>
                    <Image Width="32" Height="32" Source="{x:Bind SystemIcon, Mode=OneWay}" Visibility="{x:Bind SystemIconVisibility, Mode=OneWay}"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock c:MatchText.Source="{x:Bind Match}" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}"
                               Foreground="{ThemeResource PaneText1Brush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock Text="{x:Bind Folder}" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}"
                               Foreground="{ThemeResource PaneText3Brush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind Modified}" HorizontalAlignment="Right" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" LineHeight="16"
                               Foreground="{ThemeResource PaneText3Brush}"/>
                    <TextBlock Text="{x:Bind Size}" HorizontalAlignment="Right" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" LineHeight="16"
                               Foreground="{ThemeResource PaneText3Brush}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：类型标签、输入框、总在最前、关闭。空白处可拖动窗口（宿主处理） -->
        <Grid x:Name="Head" Padding="18,0,10,0" ColumnSpacing="10" Background="Transparent" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Height="28" Padding="8,0,10,0" CornerRadius="14" VerticalAlignment="Center"
                    Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:PaneIcon Glyph="folder" Width="15" Height="15" VerticalAlignment="Center" Foreground="{ThemeResource PaneText2Brush}"/>
                    <TextBlock Text="文件" VerticalAlignment="Center" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText2Brush}"/>
                </StackPanel>
            </Border>
            <TextBox x:Name="Input" Grid.Column="1" VerticalAlignment="Center" MinHeight="0" Padding="0" PlaceholderText="搜索文件和文件夹"
                     FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextLg}" SelectionHighlightColor="{StaticResource PaneAccentBrush}"
                     IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TextChanged="OnTextChanged"/>
            <Button x:Name="PinButton" Grid.Column="2" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}" Click="OnPin" ToolTipService.ToolTip="总在最前">
                <c:PaneIcon x:Name="PinIcon" Glyph="pin" Width="16" Height="16"/>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource PaneIconButton}" Width="{StaticResource PaneControlMd}" Height="{StaticResource PaneControlMd}" Click="OnClose" ToolTipService.ToolTip="关闭（Ctrl+W）">
                <c:PaneIcon Glyph="close" Width="16" Height="16"/>
            </Button>
        </Grid>

        <Grid x:Name="Body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="116"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="268"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧分类（Tab / Shift+Tab 切换） -->
            <Border BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="6,8,6,8">
                    <Grid>
                        <!-- 悬停层在下、选中层在上，都是滑动高亮（同启动器） -->
                        <Canvas x:Name="RailHover" IsHitTestVisible="False"/>
                        <Canvas x:Name="RailHighlight" IsHitTestVisible="False"/>
                        <ItemsControl x:Name="Rail" ItemTemplate="{StaticResource CategoryTemplate}" IsTabStop="False" Tapped="OnRailTapped"
                                      PointerMoved="OnRailPointerMoved" PointerExited="OnRailPointerExited"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 结果：虚拟化，滚到接近底部再要下一批 -->
            <Grid Grid.Column="1">
                <!-- 系统滚动条隐藏，右边画一条 Pane 自己的细滚动条（滚动或鼠标在列表上时出现，可拖） -->
                <ScrollViewer x:Name="ListScroller" Padding="8,6,8,6" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ViewChanged="OnListScrolled" IsTabStop="False"
                              PointerEntered="OnListPointerEntered" PointerExited="OnListPointerExited" SizeChanged="OnListSizeChanged">
                    <Grid>
                        <Canvas x:Name="ListHighlight" IsHitTestVisible="False"/>
                        <ItemsRepeater x:Name="List" ItemTemplate="{StaticResource FileTemplate}" Tapped="OnListTapped" DoubleTapped="OnListDoubleTapped"
                                       PointerPressed="OnListPressed" PointerMoved="OnListMoved" PointerReleased="OnListReleased"/>
                    </Grid>
                </ScrollViewer>
                <Border x:Name="ScrollTrack" Width="12" HorizontalAlignment="Right" Margin="0,6,1,6" Background="Transparent" Visibility="Collapsed"
                        PointerEntered="OnThumbEntered" PointerExited="OnThumbExited" PointerPressed="OnThumbPressed" PointerMoved="OnThumbMoved"
                        PointerReleased="OnThumbReleased" PointerCaptureLost="OnThumbCaptureLost" PointerWheelChanged="OnThumbWheel">
                    <Border x:Name="ScrollThumb" Width="4" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="2"
                            Background="{ThemeResource PaneText3Brush}" Opacity="0"/>
                </Border>
                <TextBlock x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,60,20,0" TextAlignment="Center" TextWrapping="Wrap" LineHeight="24"
                           FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText3Brush}"/>
            </Grid>

            <!-- 右侧预览 -->
            <Border x:Name="Preview" Grid.Column="2" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1,0,0,0" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="ThumbBox" CornerRadius="{StaticResource PaneRadiusItem}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                        <Grid>
                            <Border x:Name="ThumbTile" Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <c:PaneIcon x:Name="ThumbGlyph" Width="32" Height="32" StrokeWidth="2" Foreground="White"/>
                            </Border>
                            <Image x:Name="ThumbSystem" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <Image x:Name="ThumbImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Border x:Name="TextHeadBox" Padding="12,10,12,10" Visibility="Collapsed" CornerRadius="{StaticResource PaneRadiusItem}"
                            Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                        <TextBlock x:Name="TextHead" FontFamily="{StaticResource PaneFontMono}" FontSize="11" LineHeight="17.6" TextWrapping="Wrap"
                                   Foreground="{ThemeResource PaneText2Brush}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <TextBlock x:Name="PreviewName" Grid.Row="1" TextWrapping="Wrap" LineHeight="20" FontWeight="SemiBold"
                               FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" Foreground="{ThemeResource PaneText1Brush}"/>
                    <Grid x:Name="Meta" Grid.Row="2" ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6">
                        <Button Style="{StaticResource PaneTextButton}" CornerRadius="14" Content="打开" Click="OnOpenSelected"/>
                        <Button Style="{StaticResource PaneTextButton}" CornerRadius="14" Content="所在文件夹" Click="OnRevealSelected"/>
                        <Button Style="{StaticResource PaneTextButton}" CornerRadius="14" Content="复制路径" Click="OnCopyPath"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底栏：排序、预览开关、按键说明、数量 -->
        <Grid Grid.Row="2" Padding="16,0,16,0" ColumnSpacing="16" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SortButton" Style="{StaticResource PaneIconButton}" Width="NaN" Height="{StaticResource PaneControlSm}" Padding="6,0,6,0" CornerRadius="6" Click="OnSort" VerticalAlignment="Center"
                    ToolTipService.ToolTip="换排序">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <c:PaneIcon Glyph="sliders" Width="13" Height="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SortText" Text="按相关度" VerticalAlignment="Center" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}"/>
                </StackPanel>
            </Button>
            <StackPanel x:Name="PreviewToggle" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="预览" VerticalAlignment="Center" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            </StackPanel>
            <c:WrapPanel x:Name="Hints" Grid.Column="3" VerticalAlignment="Center" HorizontalSpacing="12" VerticalSpacing="0"/>
            <TextBlock x:Name="TotalText" Grid.Column="4" VerticalAlignment="Center" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
        </Grid>

        <!-- 样板（NativeAOT 下不按名字查资源） -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="HintLabelProto" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            <TextBlock x:Name="MetaValueProto" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
            <Border x:Name="KbdProto" Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}"/></Border>
            <Border x:Name="SwitchProto" Background="{ThemeResource PaneFillControlBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}"/>
            <Border x:Name="AccentProto" Background="{StaticResource PaneAccentBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
