<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 结果卡片（设计负责人），启动器和超级面板共用。照原型 .ai-card：
  标题行（图标 + 动作名 + 右侧模型）→ 原文（可选，左边竖线）→ 逐字出现的结果（带闪烁光标）→ 快捷键提示。
  另有「还没配置 AI 服务」和「出错」两种状态（docs/design.md「AI · 状态与出错」：卡片里写明原因，不弹窗）。
-->
<UserControl
    x:Class="Pane.Views.Controls.AiCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="False">

    <StackPanel>
        <!-- 标题行 -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <c:PaneIcon x:Name="HeadIcon" Width="16" Height="16" VerticalAlignment="Center" Foreground="{ThemeResource PaneText2Brush}"/>
            <TextBlock x:Name="HeadTitle" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" Foreground="{ThemeResource PaneText1Brush}"/>
            <TextBlock x:Name="HeadModel" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
        </Grid>

        <!-- 原文 -->
        <Border x:Name="SourceBox" Margin="0,8,0,0" Padding="10,0,0,0" BorderThickness="2,0,0,0"
                BorderBrush="{ThemeResource PaneStrokeBrush}" Visibility="Collapsed">
            <TextBlock x:Name="SourceText" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextSm}" LineHeight="19"
                       Foreground="{ThemeResource PaneText2Brush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- 结果 -->
        <ScrollViewer x:Name="OutScroll" Margin="0,8,0,0" MaxHeight="300" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
            <RichTextBlock x:Name="Out" FontFamily="{StaticResource PaneFontUi}" Foreground="{ThemeResource PaneText1Brush}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" SelectionHighlightColor="{StaticResource PaneAccentBrush}">
                <Paragraph>
                    <Run x:Name="OutRun"/>
                    <InlineUIContainer>
                        <Border x:Name="Caret" Width="2" Background="{ThemeResource PaneText1Brush}" Margin="2,0,0,-3"/>
                    </InlineUIContainer>
                </Paragraph>
            </RichTextBlock>
        </ScrollViewer>

        <!-- 未配置 / 出错 -->
        <StackPanel x:Name="ProblemBox" Margin="0,8,0,0" Spacing="10" Visibility="Collapsed">
            <TextBlock x:Name="ProblemText" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}" LineHeight="22"
                       Foreground="{ThemeResource PaneText1Brush}" TextWrapping="Wrap"/>
            <Button x:Name="ProblemButton" Style="{StaticResource PaneTextButton}" HorizontalAlignment="Left" Click="OnProblemButton"/>
        </StackPanel>

        <!-- 快捷键提示 -->
        <Grid Margin="0,12,0,0">
            <Border Height="1" VerticalAlignment="Top" Background="{ThemeResource PaneStrokeBrush}"/>
            <c:WrapPanel x:Name="Foot" Margin="0,8,0,0" HorizontalSpacing="14" VerticalSpacing="4"/>
            <TextBlock x:Name="HintLabelProto" Visibility="Collapsed" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            <Border x:Name="KbdProto" Visibility="Collapsed" Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}"/></Border>
        </Grid>
    </StackPanel>
</UserControl>
