<?xml version="1.0" encoding="utf-8"?>
<!--
  对话框搜索框（设计负责人，2026-11-23，issue 81）。照原型 prototype/dialog-search.html 的 .dsb。
  平时一行 40 高：搜索图标、输入框、文件类型小标签、分隔、两个图标按钮（资源管理器当前文件夹 = Ctrl+G，已打开和最近使用的文件夹 = Ctrl+Shift+G）。
  聚焦后展开结果（最高 312，按这一侧剩下的空间压低）和一行按键提示；贴在对话框上方时结果往上展开（Up）。
-->
<UserControl
    x:Class="Pane.Views.DialogSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Pane.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pane.Views.Controls"
    IsTabStop="False">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeadRow" Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Head" Padding="12,0,6,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:PaneIcon Glyph="search" Width="16" Height="16" VerticalAlignment="Center" Foreground="{ThemeResource PaneText3Brush}"/>
            <TextBox x:Name="Input" Grid.Column="1" VerticalAlignment="Center" MinHeight="0" Padding="0" c:TextBleed.Bleed="4"
                     PlaceholderText="{x:Bind loc:Strings.DialogSearch_Placeholder}" PlaceholderForeground="{ThemeResource PaneText3Brush}"
                     FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextMd}"
                     SelectionHighlightColor="{StaticResource PaneAccentBrush}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                     TextChanged="OnTextChanged" PreviewKeyDown="OnInputKeyDown" GotFocus="OnInputFocus"/>
            <!-- 对话框限定了文件类型时：「仅显示图像文件」 -->
            <Border x:Name="FilterChip" Grid.Column="2" Height="20" CornerRadius="10" Padding="8,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
                    Background="{ThemeResource PaneFillSelectedBrush}" BorderBrush="{ThemeResource PaneStrokeBrush}" BorderThickness="1">
                <TextBlock x:Name="FilterText" VerticalAlignment="Center" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText2Brush}"/>
            </Border>
            <Border Grid.Column="3" Width="1" Height="16" VerticalAlignment="Center" Background="{ThemeResource PaneStrokeBrush}"/>
            <Button Grid.Column="4" Style="{StaticResource PaneIconButton}" VerticalAlignment="Center" Click="OnExplorerClick"
                    ToolTipService.ToolTip="{x:Bind loc:Strings.DialogSearch_ExplorerHint}" AutomationProperties.Name="{x:Bind loc:Strings.DialogSearch_ExplorerHint}">
                <c:PaneIcon Glyph="folder-open" Width="15" Height="15" Foreground="{ThemeResource PaneText2Brush}"/>
            </Button>
            <Button Grid.Column="5" Style="{StaticResource PaneIconButton}" VerticalAlignment="Center" Click="OnRecentClick"
                    ToolTipService.ToolTip="{x:Bind loc:Strings.DialogSearch_RecentHint}" AutomationProperties.Name="{x:Bind loc:Strings.DialogSearch_RecentHint}">
                <c:PaneIcon Glyph="history" Width="15" Height="15" Foreground="{ThemeResource PaneText2Brush}"/>
            </Button>
        </Grid>

        <Grid x:Name="Body" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="BodyLine" Height="1" VerticalAlignment="Top" Background="{ThemeResource PaneStrokeBrush}"/>
            <c:ScrollFade Thumb="False">
                <ScrollViewer x:Name="Scroller" Margin="0,1,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
                    <Grid x:Name="ListContent" Padding="6,4,6,6">
                        <Canvas x:Name="HighlightLayer" IsHitTestVisible="False"/>
                        <StackPanel x:Name="Rows"/>
                    </Grid>
                </ScrollViewer>
            </c:ScrollFade>
        </Grid>

        <Grid x:Name="Foot" Grid.Row="2" Visibility="Collapsed">
            <Border x:Name="FootLine" Height="1" VerticalAlignment="Top" Background="{ThemeResource PaneStrokeBrush}"/>
            <c:WrapPanel x:Name="Hints" Margin="12,8,12,8" HorizontalSpacing="12" VerticalSpacing="4"/>
            <TextBlock x:Name="HintLabelProto" Visibility="Collapsed" FontFamily="{StaticResource PaneFontUi}" FontSize="{StaticResource PaneTextXs}" Foreground="{ThemeResource PaneText3Brush}"/>
            <Border x:Name="KbdProto" Visibility="Collapsed" Style="{StaticResource PaneKbdBorder}"><TextBlock Style="{StaticResource PaneKbdText}"/></Border>
            <TextBlock x:Name="LabelProto" Visibility="Collapsed" Style="{StaticResource PaneGroupLabel}"/>
        </Grid>
    </Grid>
</UserControl>
