<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><RootNamespace>Pane</RootNamespace><ApplicationIcon>Assets\pane.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <SelfContained>true</SelfContained>
    <!-- issue #31 / 调研 073：关闭 CET，兼容进程内 .NET Framework Shell 扩展的异常恢复。 -->
    <CETCompat>false</CETCompat>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Pane.Gestures/Pane.Gestures.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../tests/Pane.App.Probes/LocalizationProbe.cs" Link="Diagnostics/LocalizationProbe.cs" /><Compile Include="../../tests/Pane.App.Probes/SetupProbe.cs" Link="Diagnostics/SetupProbe.cs" /><Compile Include="../../tests/Pane.App.Probes/ReleaseProbe.cs" Link="Diagnostics/ReleaseProbe.cs" /><Compile Include="../../tests/Pane.App.Probes/App.Diagnostics.cs" Link="Diagnostics/App.Diagnostics.cs" /></ItemGroup>
  <ItemGroup><Content Include="Services/Launcher/Data/*" Link="LauncherData/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Update="Assets/pane.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><Content Update="Assets/pane-app.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><Content Include="bin/native/Pane.Effect.dll" Link="Pane.Effect.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
  <ItemGroup><Content Include="bin/native/Pane.Native.dll" Link="Pane.Native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <Target Name="BuildNativeEffect" BeforeTargets="PrepareForBuild"><Exec Command="powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File &quot;$(MSBuildProjectDirectory)/scripts/native.ps1&quot;" /></Target>
  <Target Name="CopyAppResources" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFiles="$(TargetDir)resources.pri" />
  </Target>
  <Target Name="PublishAppResources" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFiles="$(PublishDir)resources.pri" />
  </Target>
  <ItemGroup><Compile Include="../../tests/Pane.App.Probes/PanelKeysProbe.cs" Link="Diagnostics/PanelKeysProbe.cs" /></ItemGroup>
  <Target Name="GenerateReleaseNotes" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File &quot;$(MSBuildProjectDirectory)/../../scripts/release-notes.ps1&quot; -Source &quot;$(MSBuildProjectDirectory)/ReleaseNotes&quot; -Output &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)release-notes&quot; -Version &quot;$(Version)&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)release-notes/catalog.json" LogicalName="Pane.ReleaseNotes.json" />
      <Content Include="$(IntermediateOutputPath)release-notes/release-notes.md" Link="release-notes.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Import Project="Localization/Localization.targets" />
  <ItemGroup><Compile Include="../../tests/Pane.App.Probes/SetupFailureProbe.cs" Link="Diagnostics/SetupFailureProbe.cs" /></ItemGroup>
</Project>
